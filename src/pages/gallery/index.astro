---
import Layout from "../../layouts/Layout.astro";
import ky from "ky";

const SECRET_KEY = import.meta.env.CLOUDINARY_API_SECRET;
const PUBLIC_KEY = import.meta.env.PUBLIC_CLOUDINARY_API_KEY;
const CLOUD_NAME = import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME;

type CloudinaryResponse = {
  folders: Array<{
    name: string;
  }>;
};

const response = (await ky
  .get(`https://api.cloudinary.com/v1_1/${CLOUD_NAME}/folders`, {
    headers: {
      Authorization: `Basic ${btoa(`${PUBLIC_KEY}:${SECRET_KEY}`)}`,
    },
  })
  .json()) as CloudinaryResponse;
---

<Layout title="Gallery">
  <section
    class="flex flex-col items-center justify-center w-full bg-cover bg-center py-20 md:py-0 overflow-hidden flex-1 mt-60"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        response.folders.map((folder) => (
          <a
            class="block p-4 border rounded-lg hover:bg-gray-100 fade-out"
            onclick={`handleRedirect('${folder.name}')`}
          >
            <h2 class="zoomableHeading relative z-10 text-lg font-semibold">
              {folder.name}
            </h2>
          </a>
        ))
      }
    </div>
    <div id="svgContainer" class="absolute top-0 h-1/2">
      <object
        id="svgObject"
        type="image/svg+xml"
        data="/BWmap.svg"
        class="w-full h-full"></object>
    </div>
  </section>
</Layout>

<script>
  declare global {
    interface Window {
      handleRedirect: (folderName: string) => void;
    }
  }

  // Reset styles when the page is loaded
  window.addEventListener("pageshow", () => {
    const svgContainer = document.getElementById("svgContainer");
    const gridItems = document.querySelectorAll(".fade-out");

    if (svgContainer) {
      svgContainer.style.transform = "scale(1)"; // Reset the scale
      svgContainer.style.transition = ""; // Remove any lingering transitions
    }

    // Reset the grid items' opacity and display styles
    gridItems.forEach((gridItem) => {
      gridItem.classList.remove("opacity-0"); // Remove the fade-out class
      (gridItem as HTMLElement).style.display = ""; // Reset the display style
    });
  });

  window.handleRedirect = function (folderName) {
    console.log("handleRedirect called with folderName:", folderName); // Debugging
    const gridItems = document.querySelectorAll(".fade-out");
    const svgContainer = document.getElementById("svgContainer");

    // Apply the fade-out animation to all grid items
    gridItems.forEach((gridItem) => {
      console.log("Applying fade-out to:", gridItem); // Debugging
      gridItem.classList.add(
        "opacity-0",
        "transition-opacity",
        "duration-1000"
      );
    });

    // Apply the zoom animation to the SVG container
    if (svgContainer) {
      console.log("Applying zoom animation to SVG container"); // Debugging
      setTimeout(() => {
        svgContainer.style.transform = "scale(70)";
        svgContainer.style.transition = "transform 10s ease";
      }, 1000); // Delay the zoom animation to start after the fade-out
    } else {
      console.error("SVG Container not found!"); // Debugging
    }

    // Redirect after the animations complete
    setTimeout(() => {
      window.location.href = `/gallery/${folderName}`;
    }, 5000); // Let the fade-out animation finish before redirecting
  };
</script>
