---
import siteConfig from "../../site.config.mjs";
import SocialIcon from "./SocialIcon.astro";

const year = new Date().getFullYear();
const owner = siteConfig.owner;
const socialLinks = siteConfig.socialLinks;
const { theme = "light" } = Astro.props;
---

<footer
  class={`py-10 border-t mt-auto ${theme === "dark" ? "bg-black border-gray-700 text-gray-300" : "bg-white border-gray-100 text-gray-500"}`}
>
  <div class="container mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-center">
      <div class="text-sm font-sans mb-4 md:mb-0">
        © {year}
        {owner}. All rights reserved.
      </div>

      <div class="flex space-x-6 items-center">
        {
          socialLinks.map((socialLink) => (
            <SocialIcon socialLink={socialLink} />
          ))
        }
      </div>
    </div>
  </div>
</footer>
